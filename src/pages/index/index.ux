<template>
  <div class="page">
    <!-- 顶栏：左 收藏开关 / 右 更多，标题 32px 居中（无源流沙 规范） -->
    <div class="topbar">
      <!-- 左：收藏开关（存当前这句）  右：更多（进过渡页选 搜索/收藏/关于） -->
      <div class="icon-btn fav-on" if="{{isFav}}" onclick="toggleFav">
        <text class="icon-btn-text">已藏</text>
      </div>
      <div class="icon-btn" if="{{showFavOff}}" onclick="toggleFav">
        <text class="icon-btn-text">收藏</text>
      </div>
      <text class="title">一言</text>
      <div class="icon-btn" onclick="goToMenu">
        <text class="icon-btn-text">更多</text>
      </div>
    </div>

    <!--
      正文卡片：不用 <scroll>（真机上内部拿不到 width:100%，文字会贴边），
      也不用动态绑定的 style（实测内存杀手，7000 条会 OOM）。
      长句靠多档静态字号 + if 条件挑选完整显示：每个档位是一个写死
      font-size 的 CSS 类，模板里按 textSize 只显示其中一个。
      这种 if 切换与出处/提示是同一套机制，7000 条下已验证稳定。
    -->
    <div class="card">
      <div class="text-area">
        <text class="hitokoto-text sz32" if="{{textSize == 32}}">{{currentText}}</text>
        <text class="hitokoto-text sz28" if="{{textSize == 28}}">{{currentText}}</text>
        <text class="hitokoto-text sz24" if="{{textSize == 24}}">{{currentText}}</text>
        <text class="hitokoto-text sz20" if="{{textSize == 20}}">{{currentText}}</text>
        <text class="hitokoto-text sz17" if="{{textSize == 17}}">{{currentText}}</text>
        <text class="hitokoto-text sz14" if="{{textSize == 14}}">{{currentText}}</text>
        <text class="hitokoto-text sz12" if="{{textSize == 12}}">{{currentText}}</text>
        <text class="hitokoto-text sz10" if="{{textSize == 10}}">{{currentText}}</text>
      </div>
      <!-- 出处：字号同样按长度自适应（优先压成一行，太长才两行） -->
      <div class="from-box" if="{{showFrom}}">
        <text class="from-text sz28" if="{{fromSize == 28}}">{{currentFrom}}</text>
        <text class="from-text sz24" if="{{fromSize == 24}}">{{currentFrom}}</text>
        <text class="from-text sz20" if="{{fromSize == 20}}">{{currentFrom}}</text>
        <text class="from-text sz17" if="{{fromSize == 17}}">{{currentFrom}}</text>
        <text class="from-text sz14" if="{{fromSize == 14}}">{{currentFrom}}</text>
        <text class="from-text sz12" if="{{fromSize == 12}}">{{currentFrom}}</text>
        <text class="from-text sz10" if="{{fromSize == 10}}">{{currentFrom}}</text>
      </div>
    </div>

    <!-- 主操作：换一句 -->
    <div class="primary-btn" onclick="refreshSentence">
      <text class="primary-text">换一句</text>
    </div>

    <text class="hint" if="{{showHint}}">{{hint}}</text>
  </div>
</template>

<style>
  /* ---- 设计令牌（无源流沙 / 小米手环 9 Pro，画布 336x480）----
     背景 #000000   卡片与圆钮 #262626   强调 #0D6EFF
     文字：标题/正文 32 白   次要 28 白 60%（#999999）
     圆钮 72x72   卡片圆角 20   页面边距 6   屏角半径 48 */
  .page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    /* 左右各留 6；上下边距交给子元素（页面本身带 padding 会额外占高，
       整个纵向会超出屏幕，底部按钮被裁成半个胶囊） */
    padding: 0 6px;
    background-color: #000000;
  }

  .topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 56px;
    margin-top: 6px;
    margin-bottom: 6px;
  }

  .title {
    flex: 1;
    font-size: 32px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
  }

  .icon-btn {
    width: 56px;
    height: 56px;
    justify-content: center;
    align-items: center;
    border-radius: 28px;
    background-color: #262626;
  }

  .icon-btn-text {
    font-size: 22px;
    color: #ffffff;
    text-align: center;
  }

  /* 卡片自己负责居中（真机验证过的做法，不要依赖内层 width:100%）
     padding 压到 6：文字离灰框边缘尽量近，同样高度能放更大的字号 */
  .card {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex: 1;
    width: 100%;
    padding: 6px;
    background-color: #262626;
    border-radius: 20px;
  }

  /* 正文区：占满卡片剩余高度，两个方向都居中 */
  .text-area {
    flex: 1;
    width: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* 正文公共样式：颜色/居中/换行上限（字号由下面的档位类给） */
  .hitokoto-text {
    color: #ffffff;
    text-align: center;
    width: 100%;
    lines: 20;
    text-overflow: ellipsis;
  }

  /* 字号档位：只改 font-size，其余继承 .hitokoto-text
     （与模板 if 条件、JS 里的 SIZES 一一对应，改一处要同步改三处） */
  .sz32 { font-size: 32px; }
  .sz28 { font-size: 28px; }
  .sz24 { font-size: 24px; }
  .sz20 { font-size: 20px; }
  .sz17 { font-size: 17px; }
  .sz14 { font-size: 14px; }
  .sz12 { font-size: 12px; }
  .sz10 { font-size: 10px; }

  /* 出处：白 60% ~ #999999；字号跟着正文档位走（复用上面的 .szN），lines:2 只作安全上限 */
  .from-box {
    width: 100%;
    flex-direction: column;
    align-items: flex-end;
    margin-top: 4px;
  }

  .from-text {
    color: #999999;
    text-align: right;
    width: 100%;
    lines: 2;
    text-overflow: ellipsis;
  }


  /* 已收藏时顶栏左钮用强调色 */
  .fav-on {
    background-color: #0d6eff;
  }

  /* 主操作：换一句胶囊 */
  .primary-btn {
    justify-content: center;
    align-items: center;
    width: 240px;
    height: 56px;
    margin-top: 6px;
    margin-bottom: 6px;
    border-radius: 28px;
    background-color: #0d6eff;
  }

  .primary-text {
    font-size: 28px;
    color: #ffffff;
    text-align: center;
  }

  .hint {
    font-size: 20px;
    color: #999999;
    text-align: center;
    width: 100%;
    lines: 1;
    text-overflow: ellipsis;
    margin-top: 4px;
  }
</style>

<script>
  import logic from '../../common/scripts/logic.js';
  import fav from '../../common/scripts/fav.js';
  import router from '@system.router';
  import device from '@system.device';

  // 水平方向被吃掉的宽度：页面左右 padding 6*2 + 卡片 padding 6*2
  const TEXT_INSET = 24;
  // 竖向固定占用（改上面 CSS 的尺寸时，这几个数要跟着改）
  // 注意 PAGE_PAD_V 必须是 0：上下 6 的边距已经算进 TOPBAR_H / BTN_H 里了，
  // 再写成 12 会重复扣一次，正文可用高度少 12px。
  const PAGE_PAD_V = 0;
  const TOPBAR_H = 68;        // topbar 56 + 上下 margin 各 6
  const BTN_H = 68;           // primary-btn 56 + 上下 margin 各 6
  const CARD_PAD_V = 12;      // card padding 6*2
  const HINT_H = 26;          // hint 行高 + margin（仅 showHint 时占位）

  // 出处字号 = 正文档位往下退一档（32->28 正对应设计稿的标题 32 / 次要 28；
  // 正文缩到 14 时出处就跟着 12，不会出现出处比正文还大）。
  // 与 SIZES 一一对应，改 SIZES 时这张表要同步。
  const FROM_OF_BODY = [28, 24, 20, 17, 14, 12, 10, 10];
  const FROM_LINES_MAX = 2;      // 出处最多两行，超出走省略号
  const FROM_LINE_RATIO = 1.5;   // 出处行高/字号
  const FROM_MARGIN = 8;

  // 字号档位（与模板 if 条件、上面的 .szN 类一一对应）
  const SIZES = [32, 28, 24, 20, 17, 14, 12, 10];
  const LINE_RATIO = 1.7;     // 行高/字号，往大里估，宁可多缩一档
  const NARROW = 0.55;        // 半角字符按 0.55 个汉字宽

  const MIN_AREA_H = 40;
  const FALLBACK_SCREEN_H = 480;
  const FALLBACK_SCREEN_W = 336;

  export default {
    data: {
      currentText: '加载中…',
      currentFrom: '',
      fromRaw: '',
      showFrom: false,
      fromSize: 28,
      // 收藏状态（showFavOff 是取反，模板里不写复杂表达式）
      isFav: false,
      showFavOff: true,
      hint: '',
      showHint: false,
      screenWidth: 0,
      screenHeight: 0,
      textSize: 32
    },

    onInit() {
      console.info('一言：主页 onInit');
      this.syncScreen();
      this.loadRandom();
    },

    onShow() {
      this.syncScreen();
      // 从收藏页返回时，收藏状态可能变了
      this.refreshFav();
    },

    /** 读屏幕尺寸：缩字号要按可用面积算，宽高都得拿到。 */
    syncScreen() {
      let w = 0;
      let h = 0;
      try {
        const app = this.$app;
        w = (app && app.$def && app.$def.screenWidth) || 0;
        h = (app && app.$def && app.$def.screenHeight) || 0;
      } catch (e) {
        w = 0;
        h = 0;
      }
      if (w) {
        this.screenWidth = w;
      }
      if (h) {
        this.screenHeight = h;
      }
      this.applySize();

      if (w && h) {
        return;
      }
      try {
        device.getInfo({
          success: (info) => {
            if (!info) {
              return;
            }
            if (info.screenWidth) {
              this.screenWidth = info.screenWidth;
            }
            if (info.screenHeight) {
              this.screenHeight = info.screenHeight;
            }
            this.applySize();
          },
          fail: () => {}
        });
      } catch (e) {
        console.error('一言：主页获取屏幕信息异常 ' + e);
      }
    },

    /** 字数换算成汉字宽度单位数（半角按 0.55 计） */
    unitsOf(s) {
      let n = 0;
      for (let i = 0; i < s.length; i++) {
        n += s.charCodeAt(i) >= 0x2e80 ? 1 : NARROW;
      }
      return n;
    },

    /** 出处要占几行（给出的字号下） */
    linesAtSize(s, f) {
      const w = (this.screenWidth || FALLBACK_SCREEN_W) - TEXT_INSET;
      if (!s || w <= 0 || !f) {
        return 0;
      }
      let lines = Math.ceil(this.unitsOf(s) * f / w);
      if (lines < 1) {
        lines = 1;
      }
      if (lines > FROM_LINES_MAX) {
        lines = FROM_LINES_MAX;
      }
      return lines;
    },

    /**
     * 出处字号：跟着正文档位走（往下退一档）；名字实在太长再逐步往下让，
     * 保证不超过两行。
     */
    fromSizeFor(bodySize) {
      const s = this.currentFrom || '';
      let idx = 0;
      for (let i = 0; i < SIZES.length; i++) {
        if (SIZES[i] === bodySize) {
          idx = i;
          break;
        }
      }
      for (let i = idx; i < SIZES.length; i++) {
        if (this.linesAtSize(s, FROM_OF_BODY[i]) <= FROM_LINES_MAX) {
          return FROM_OF_BODY[i];
        }
      }
      return SIZES[SIZES.length - 1];
    },

    /** 出处占的高度（按它自己的字号算，用于给正文留高度） */
    fromHeight() {
      const lines = this.linesAtSize(this.currentFrom, this.fromSize);
      if (!lines) {
        return 0;
      }
      return lines * (this.fromSize || SIZES[0]) * FROM_LINE_RATIO + FROM_MARGIN;
    },

    /** 正文可用高度（只用来挑字号，不绑到样式上）；srcH 由调用方传入以免循环依赖 */
    areaHeight(srcH) {
      const sh = this.screenHeight || FALLBACK_SCREEN_H;
      const hint = this.showHint ? HINT_H : 0;
      const h = sh - PAGE_PAD_V - TOPBAR_H - BTN_H - hint - CARD_PAD_V - (srcH || 0);
      return h > MIN_AREA_H ? h : MIN_AREA_H;
    },

    /**
     * 从档位里挑一个整句能完整放下的最大字号。
     * 字号 f 时每行放 W/f 个汉字单位，需要 ceil(units*f/W) 行，
     * 总高 ~ 行数 * f * LINE_RATIO <= H。
     */
    pickSize(text, srcH) {
      if (!text) {
        return SIZES[0];
      }
      const units = this.unitsOf(text);
      const w = (this.screenWidth || FALLBACK_SCREEN_W) - TEXT_INSET;
      const h = this.areaHeight(srcH);
      if (units <= 0 || w <= 0 || h <= 0) {
        return SIZES[0];
      }
      for (let i = 0; i < SIZES.length; i++) {
        const f = SIZES[i];
        const lines = Math.ceil(units * f / w);
        if (lines * f * LINE_RATIO <= h) {
          return f;
        }
      }
      return SIZES[SIZES.length - 1];
    },

    /**
     * 正文字号与出处字号互相依赖（出处高度占正文的地方），做两遍：
     * 第一遍估正文 -> 得出处 -> 用出处实际高度再算一次正文 -> 出处跟着新正文走。
     * 第二遍的预留高度不小于最终实际高度，所以不会溢出。
     */
    applySize() {
      const text = this.currentText;
      const first = this.pickSize(text, 0);
      this.fromSize = this.fromSizeFor(first);
      const second = this.pickSize(text, this.fromHeight());
      this.fromSize = this.fromSizeFor(second);
      this.textSize = second;
    },

    /** 取一条随机句子并刷新界面。全程 try/catch，避免异常导致白屏。 */
    loadRandom() {
      try {
        const total = logic.init();
        console.info('一言：可用句子 ' + total + ' 条');
        const item = logic.getRandom();
        if (item && item.t) {
          this.currentText = item.t;
          this.fromRaw = item.f || '';
          this.currentFrom = item.f ? '—— ' + item.f : '';
          this.showFrom = !!item.f;
          this.hint = '';
          this.showHint = false;
          this.applySize();
          this.refreshFav();
          console.info('一言：正文 ' + item.t.length + ' 字，字号 ' + this.textSize);
        } else {
          this.currentText = '暂无数据';
          this.showFrom = false;
          this.hint = '句子数据读取为空';
          this.showHint = true;
          this.applySize();
        }
      } catch (e) {
        const msg = (e && e.message) ? e.message : String(e);
        console.error('一言：加载句子失败 ' + msg);
        this.currentText = '加载失败';
        this.showFrom = false;
        this.hint = '错误：' + msg;
        this.showHint = true;
        this.applySize();
      }
    },

    refreshSentence() {
      this.loadRandom();
    },

    /** 刷新当前这条的收藏状态 */
    refreshFav() {
      const t = this.currentText;
      if (!t) {
        return;
      }
      try {
        fav.has(t, (yes) => {
          this.isFav = yes;
          this.showFavOff = !yes;
        });
      } catch (e) {
        console.error('一言：读取收藏状态异常 ' + e);
      }
    },

    /** 点收藏：切换收藏状态 */
    toggleFav() {
      const t = this.currentText;
      if (!t) {
        return;
      }
      try {
        fav.toggle({ t: t, f: this.fromRaw || '' }, (nowFav, list, ok) => {
          this.isFav = nowFav;
          this.showFavOff = !nowFav;
          if (!ok) {
            this.hint = nowFav ? '收藏保存失败' : '取消收藏失败';
            this.showHint = true;
          } else {
            console.info('一言：收藏 ' + (nowFav ? '已添加' : '已移除') + '，共 ' + list.length + ' 条');
          }
        });
      } catch (e) {
        console.error('一言：收藏操作异常 ' + e);
      }
    },

    /** 更多：进过渡页，再从那里进 搜索/收藏/关于 */
    goToMenu() {
      router.push({ uri: 'pages/menu' });
    },

    onBackPress() {
      return false;
    }
  };
</script>
