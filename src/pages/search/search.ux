<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <!-- 注意：根节点不要使用 class="page"，
       InputMethod 组件内部的 .page 是 position:absolute，样式会互相污染。 -->
  <div class="s-page">
    <!-- 顶栏：72 圆钮 + 居中标题；命中条数跟在标题旁边（无源流沙规范） -->
    <div class="s-topbar">
      <div class="s-icon-btn" onclick="goBack">
        <text class="s-icon-btn-text">返回</text>
      </div>
      <div class="s-titlebox">
        <text class="s-title">搜索</text>
        <text class="s-count" if="{{showResult}}">{{pageCurrent}}/{{pageTotal}}</text>
      </div>
      <div class="s-icon-btn" onclick="clearInput">
        <text class="s-icon-btn-text">清空</text>
      </div>
    </div>

    <!-- 输入行：输入卡片 + 强调色搜索圆钮 -->
    <div class="s-inputrow">
      <div class="s-inputcard" onclick="showKeyboard">
        <text class="s-inputtext" if="{{hasInput}}">{{searchText}}</text>
        <text class="s-ph" if="{{showPlaceholder}}">点这里输入出处</text>
      </div>
      <div class="s-search-btn" onclick="doSearch">
        <text class="s-icon-btn-text">搜索</text>
      </div>
    </div>

    <!-- 结果（键盘弹出时自动隐藏，避免被遮挡）
         与首页同理：不用 scroll、不用动态 style，长句靠多档静态字号 + if 挑选 -->
    <div class="s-card" if="{{showResult}}">
      <div class="s-text-area">
        <text class="s-cardtext s-sz32" if="{{textSize == 32}}">{{pageText}}</text>
        <text class="s-cardtext s-sz28" if="{{textSize == 28}}">{{pageText}}</text>
        <text class="s-cardtext s-sz24" if="{{textSize == 24}}">{{pageText}}</text>
        <text class="s-cardtext s-sz20" if="{{textSize == 20}}">{{pageText}}</text>
        <text class="s-cardtext s-sz17" if="{{textSize == 17}}">{{pageText}}</text>
        <text class="s-cardtext s-sz14" if="{{textSize == 14}}">{{pageText}}</text>
        <text class="s-cardtext s-sz12" if="{{textSize == 12}}">{{pageText}}</text>
        <text class="s-cardtext s-sz10" if="{{textSize == 10}}">{{pageText}}</text>
      </div>
      <!-- 出处字号按长度自适应（同首页） -->
      <div class="s-from-box" if="{{showFrom}}">
        <text class="s-cardfrom s-sz28" if="{{fromSize == 28}}">{{pageFrom}}</text>
        <text class="s-cardfrom s-sz24" if="{{fromSize == 24}}">{{pageFrom}}</text>
        <text class="s-cardfrom s-sz20" if="{{fromSize == 20}}">{{pageFrom}}</text>
        <text class="s-cardfrom s-sz17" if="{{fromSize == 17}}">{{pageFrom}}</text>
        <text class="s-cardfrom s-sz14" if="{{fromSize == 14}}">{{pageFrom}}</text>
        <text class="s-cardfrom s-sz12" if="{{fromSize == 12}}">{{pageFrom}}</text>
        <text class="s-cardfrom s-sz10" if="{{fromSize == 10}}">{{pageFrom}}</text>
      </div>
    </div>

    <!-- 翻页（矮一档，把高度让给结果卡片） -->
    <div class="s-nav" if="{{showResult}}">
      <div class="s-navbtn" onclick="prevPage">
        <text class="s-navtext">上一句</text>
      </div>
      <div class="s-navbtn" onclick="nextPage">
        <text class="s-navtext">下一句</text>
      </div>
    </div>

    <text class="s-hint" if="{{showHint}}">{{extraText}}</text>

    <input-method
      hide="{{keyboardHidden}}"
      keyboardtype="QWERTY"
      screentype="{{screenType}}"
      maxlength="8"
      oncomplete="onInputComplete"
      ondelete="onInputDelete"
    ></input-method>
  </div>
</template>

<style>
  /* ---- 设计令牌同首页：背景 #000000   卡片/圆钮 #262626   强调 #0D6EFF
     文字 32 白   次要 28 白 60%（#999999）  圆钮 72   圆角 20   边距 6 ---- */
  .s-page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    /* 同首页：上下边距交给子元素，页面本身带 padding 会溢出把底部按钮裁掉 */
    padding: 0 6px;
    background-color: #000000;
  }

  .s-topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 56px;
    margin-top: 6px;
    margin-bottom: 6px;
  }

  .s-titlebox {
    flex: 1;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .s-title {
    font-size: 32px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
  }

  .s-count {
    font-size: 24px;
    color: #999999;
    margin-left: 8px;
  }

  .s-icon-btn {
    width: 56px;
    height: 56px;
    justify-content: center;
    align-items: center;
    border-radius: 28px;
    background-color: #262626;
  }

  .s-icon-btn-text {
    font-size: 22px;
    color: #ffffff;
    text-align: center;
  }

  .s-inputrow {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 56px;
    margin-bottom: 6px;
  }

  .s-inputcard {
    flex: 1;
    height: 56px;
    justify-content: center;
    align-items: center;
    border-radius: 20px;
    background-color: #262626;
    padding: 0 12px;
  }

  .s-inputtext {
    font-size: 28px;
    color: #ffffff;
    text-align: center;
    width: 100%;
    lines: 1;
    text-overflow: ellipsis;
  }

  .s-ph {
    font-size: 28px;
    color: #999999;
    text-align: center;
    width: 100%;
    lines: 1;
    text-overflow: ellipsis;
  }

  .s-search-btn {
    width: 56px;
    height: 56px;
    margin-left: 6px;
    justify-content: center;
    align-items: center;
    border-radius: 28px;
    background-color: #0d6eff;
  }

  /* 卡片自己负责居中（同首页） */
  .s-card {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex: 1;
    width: 100%;
    padding: 6px;
    background-color: #262626;
    border-radius: 20px;
  }

  .s-text-area {
    flex: 1;
    width: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* 正文公共样式（字号由档位类给）。类名加 s- 前缀，避开键盘组件的类名空间 */
  .s-cardtext {
    color: #ffffff;
    text-align: center;
    width: 100%;
    lines: 20;
    text-overflow: ellipsis;
  }

  .s-sz32 { font-size: 32px; }
  .s-sz28 { font-size: 28px; }
  .s-sz24 { font-size: 24px; }
  .s-sz20 { font-size: 20px; }
  .s-sz17 { font-size: 17px; }
  .s-sz14 { font-size: 14px; }
  .s-sz12 { font-size: 12px; }
  .s-sz10 { font-size: 10px; }

  /* 出处：白 60%；字号跟着正文档位走（复用 .s-szN），lines:2 只作安全上限 */
  .s-from-box {
    width: 100%;
    flex-direction: column;
    align-items: flex-end;
    margin-top: 4px;
  }

  .s-cardfrom {
    color: #999999;
    text-align: right;
    width: 100%;
    lines: 2;
    text-overflow: ellipsis;
  }


  .s-nav {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 56px;
    margin-top: 6px;
    margin-bottom: 6px;
  }

  .s-navbtn {
    justify-content: center;
    align-items: center;
    width: 48%;
    height: 56px;
    border-radius: 28px;
    background-color: #262626;
  }

  .s-navtext {
    font-size: 24px;
    color: #ffffff;
    text-align: center;
  }

  .s-hint {
    font-size: 28px;
    color: #999999;
    text-align: center;
    width: 100%;
    lines: 2;
    text-overflow: ellipsis;
    margin-top: 16px;
  }
</style>

<script>
  import logic from '../../common/scripts/logic.js';
  import router from '@system.router';
  import device from '@system.device';

  // 水平方向被吃掉的宽度：页面左右 padding 6*2 + 卡片 padding 6*2
  const TEXT_INSET = 24;
  // 竖向固定占用（改上面 CSS 的尺寸时，这几个数要跟着改）
  const PAGE_PAD_V = 0;       // 上下 6 由 topbar / s-nav 的 margin 提供
  const TOPBAR_H = 68;        // s-topbar 56 + 上下 margin 各 6
  const INPUTROW_H = 68;      // s-inputrow 56 + 上下 margin 各 6
  const NAV_H = 68;           // s-nav 56 + 上下 margin 各 6
  const CARD_PAD_V = 12;      // s-card padding 6*2

  // 出处字号 = 正文档位往下退一档（同首页）
  const FROM_OF_BODY = [28, 24, 20, 17, 14, 12, 10, 10];
  const FROM_LINES_MAX = 2;
  const FROM_LINE_RATIO = 1.5;
  const FROM_MARGIN = 8;

  // 字号档位（与模板 if 条件、上面 .s-szN 类一一对应）
  const SIZES = [32, 28, 24, 20, 17, 14, 12, 10];
  const LINE_RATIO = 1.7;
  const NARROW = 0.55;

  const MIN_AREA_H = 40;
  const FALLBACK_SCREEN_H = 480;
  const FALLBACK_SCREEN_W = 336;

  export default {
    data: {
      searchText: '',
      // 命中的结果 {idx, t, f}
      results: [],
      hasResults: false,
      hasInput: false,
      extraText: '输入出处关键词后点搜索',
      showHint: true,
      // 分页
      pageCurrent: 0,
      pageTotal: 0,
      pageText: '',
      pageFrom: '',
      showFrom: false,
      fromSize: 28,
      // 显隐开关，集中计算，避免模板里写复杂表达式
      showResult: false,
      showPlaceholder: true,
      keyboardHidden: true,
      // 键盘布局：rect / pill-shaped / circle
      screenType: 'rect',
      screenWidth: 0,
      screenHeight: 0,
      textSize: 32
    },

    onInit() {
      console.info('一言：搜索页 onInit');
      // 先用应用级结果（同步可得），拿不到就保持 rect —— 绝不能默认 circle，
      // 否则方屏/药丸屏会走到 480x321 的圆屏键盘布局上。
      let shape = '';
      try {
        const app = this.$app;
        shape = (app && app.$def && app.$def.screenShape) || '';
        this.screenWidth = (app && app.$def && app.$def.screenWidth) || 0;
        this.screenHeight = (app && app.$def && app.$def.screenHeight) || 0;
      } catch (e) {
        shape = '';
      }
      this.applyShape(shape);
      // 兜底：自己再问一次设备（异步），修正应用级探测的竞态
      this.detectShape();
      this.refresh();
    },

    onShow() {
      this.detectShape();
    },

    detectShape() {
      try {
        device.getInfo({
          success: (info) => {
            if (!info) {
              return;
            }
            if (info.screenShape) {
              this.applyShape(info.screenShape);
            }
            if (info.screenWidth) {
              this.screenWidth = info.screenWidth;
            }
            if (info.screenHeight) {
              this.screenHeight = info.screenHeight;
            }
            this.applySize();
          },
          fail: () => {}
        });
      } catch (e) {
        console.error('一言：搜索页获取屏幕信息异常 ' + e);
      }
    },

    applyShape(shape) {
      if (shape === 'circle' || shape === 'pill-shaped' || shape === 'rect') {
        if (this.screenType !== shape) {
          this.screenType = shape;
          console.info('一言：搜索页 screentype=' + shape);
        }
      }
    },

    /** 字数换算成汉字宽度单位数（半角按 0.55 计） */
    unitsOf(s) {
      let n = 0;
      for (let i = 0; i < s.length; i++) {
        n += s.charCodeAt(i) >= 0x2e80 ? 1 : NARROW;
      }
      return n;
    },

    /** 出处要占几行（给出的字号下） */
    linesAtSize(s, f) {
      const w = (this.screenWidth || FALLBACK_SCREEN_W) - TEXT_INSET;
      if (!s || w <= 0 || !f) {
        return 0;
      }
      let lines = Math.ceil(this.unitsOf(s) * f / w);
      if (lines < 1) {
        lines = 1;
      }
      if (lines > FROM_LINES_MAX) {
        lines = FROM_LINES_MAX;
      }
      return lines;
    },

    /** 出处字号：跟着正文档位走（往下退一档），太长再逐步往下让（同首页） */
    fromSizeFor(bodySize) {
      const s = this.pageFrom || '';
      let idx = 0;
      for (let i = 0; i < SIZES.length; i++) {
        if (SIZES[i] === bodySize) {
          idx = i;
          break;
        }
      }
      for (let i = idx; i < SIZES.length; i++) {
        if (this.linesAtSize(s, FROM_OF_BODY[i]) <= FROM_LINES_MAX) {
          return FROM_OF_BODY[i];
        }
      }
      return SIZES[SIZES.length - 1];
    },

    /** 出处占的高度（按它自己的字号算） */
    fromHeight() {
      const lines = this.linesAtSize(this.pageFrom, this.fromSize);
      if (!lines) {
        return 0;
      }
      return lines * (this.fromSize || SIZES[0]) * FROM_LINE_RATIO + FROM_MARGIN;
    },

    /** 结果正文可用高度；srcH 由调用方传入以免循环依赖 */
    areaHeight(srcH) {
      const sh = this.screenHeight || FALLBACK_SCREEN_H;
      const h = sh - PAGE_PAD_V - TOPBAR_H - INPUTROW_H - NAV_H - CARD_PAD_V - (srcH || 0);
      return h > MIN_AREA_H ? h : MIN_AREA_H;
    },

    /** 从档位里挑一个整句能完整放下的最大字号，推导见 index.ux。 */
    pickSize(text, srcH) {
      if (!text) {
        return SIZES[0];
      }
      const units = this.unitsOf(text);
      const w = (this.screenWidth || FALLBACK_SCREEN_W) - TEXT_INSET;
      const h = this.areaHeight(srcH);
      if (units <= 0 || w <= 0 || h <= 0) {
        return SIZES[0];
      }
      for (let i = 0; i < SIZES.length; i++) {
        const f = SIZES[i];
        const lines = Math.ceil(units * f / w);
        if (lines * f * LINE_RATIO <= h) {
          return f;
        }
      }
      return SIZES[SIZES.length - 1];
    },

    /** 两遍求解：出处跟着正文档位走，正文高度又依赖出处（同首页） */
    applySize() {
      const text = this.pageText;
      const first = this.pickSize(text, 0);
      this.fromSize = this.fromSizeFor(first);
      const second = this.pickSize(text, this.fromHeight());
      this.fromSize = this.fromSizeFor(second);
      this.textSize = second;
    },

    /** 统一刷新显隐状态。 */
    refresh() {
      this.hasInput = this.searchText !== '';
      this.showPlaceholder = !this.hasInput;
      this.showResult = this.hasResults && this.keyboardHidden;
      this.showHint = !this.hasResults && this.extraText !== '';
    },

    onInputComplete(e) {
      const content = (e && e.detail && e.detail.content) || '';
      this.searchText = (this.searchText || '') + content;
      this.refresh();
    },

    onInputDelete() {
      if (this.searchText && this.searchText.length > 0) {
        this.searchText = this.searchText.substring(0, this.searchText.length - 1);
      }
      this.refresh();
    },

    showKeyboard() {
      this.keyboardHidden = false;
      this.refresh();
    },

    doSearch() {
      const k = (this.searchText || '').trim();
      this.keyboardHidden = true;

      if (!k) {
        this.hasResults = false;
        this.results = [];
        this.extraText = '请先输入关键词';
        this.refresh();
        return;
      }

      let found = [];
      try {
        found = logic.search(k) || [];
      } catch (e) {
        const msg = (e && e.message) ? e.message : String(e);
        console.error('一言：搜索失败 ' + msg);
        this.hasResults = false;
        this.results = [];
        this.extraText = '搜索出错：' + msg;
        this.refresh();
        return;
      }

      if (!found.length) {
        this.hasResults = false;
        this.results = [];
        this.extraText = '没有找到和 ' + k + ' 相关的出处';
        this.refresh();
        return;
      }

      this.results = found;
      this.hasResults = true;
      this.extraText = '';
      this.pageTotal = found.length;
      console.info('一言：搜索' + k + '命中 ' + found.length + ' 条');
      this.showPage(1);
    },

    showPage(n) {
      if (n < 1 || n > this.results.length) {
        return;
      }
      const it = this.results[n - 1];
      this.pageCurrent = n;
      this.pageText = it.t;
      this.pageFrom = it.f ? '—— ' + it.f : '';
      this.showFrom = !!it.f;
      this.applySize();
      this.refresh();
    },

    prevPage() {
      if (this.pageCurrent > 1) {
        this.showPage(this.pageCurrent - 1);
      }
    },

    nextPage() {
      if (this.pageCurrent < this.results.length) {
        this.showPage(this.pageCurrent + 1);
      }
    },

    clearInput() {
      this.searchText = '';
      this.results = [];
      this.hasResults = false;
      this.pageCurrent = 0;
      this.pageTotal = 0;
      this.pageText = '';
      this.pageFrom = '';
      this.showFrom = false;
      this.extraText = '输入出处关键词后点搜索';
      this.keyboardHidden = true;
      this.refresh();
    },

    goBack() {
      this.keyboardHidden = true;
      router.back();
    },

    onBackPress() {
      // 键盘开着就先收键盘，再按一次才返回，避免误退出
      if (this.keyboardHidden) {
        router.back();
      } else {
        this.keyboardHidden = true;
        this.refresh();
      }
      return true;
    }
  };
</script>
