    height: 72px;
    margin-bottom: 6px;
  }

  .a-title {
    flex: 1;
    font-size: 32px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
  }

  .a-icon-btn {
    width: 72px;
    height: 72px;
    justify-content: center;
