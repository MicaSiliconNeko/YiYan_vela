<template>
  <div class="a-page">
    <!-- 顶栏：返回圆钮 + 居中标题（无源流沙规范） -->
    <div class="a-topbar">
      <div class="a-icon-btn" onclick="goBack">
        <text class="a-icon-btn-text">返回</text>
      </div>
      <text class="a-title">关于</text>
      <div class="a-icon-btn-holder"></div>
    </div>

